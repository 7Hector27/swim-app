{
  "name": "swim-app",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "predev": "pnpm --filter api exec tsx src/db/predev.ts",
    "dev": "concurrently -n web,api -c blue,green \"pnpm --filter web dev\" \"pnpm --filter api dev\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:integration": "pnpm --filter api test:integration",
    "db:up": "supabase start",
    "db:down": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:sync-catalog": "pnpm --filter api db:sync-catalog",
    "db:test:up": "supabase start --workdir supabase-test",
    "db:test:down": "supabase stop --workdir supabase-test",
    "db:test:status": "supabase status --workdir supabase-test",
    "db:test:reset": "supabase db reset --workdir supabase-test",
    "db:test:migrate": "pnpm --filter api exec tsx scripts/dbTestMigrate.ts",
    "db:test:sync-catalog": "pnpm --filter api exec tsx scripts/dbTestSyncCatalog.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "supabase": "^2.120.0",
    "typescript-eslint": "^8.30.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
