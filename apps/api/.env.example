DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
# Run `pnpm db:status` and copy the keys below
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Canonical public URL of the web app.  Used to:
#   - build the /invite/<token> URL returned to owners
#   - validate the returnTo path in signup requests and set emailRedirectTo
# In production set this to your real domain, e.g. https://jgswim.com
SITE_URL=http://localhost:3000
# Integration test vars — also from `pnpm db:status`
INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key