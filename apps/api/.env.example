DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
# Run `pnpm db:status` and copy the keys below
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required to exercise the account-deletion flow locally (ADR 034):
# the API calls supabase.auth.admin.deleteUser with this key as part of
# the post-commit fan-out. Optional under APP_ENV=local, but without it
# the deletion flow 500s.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Canonical public URL of the web app.  Used to:
#   - build the /invite/<token> URL returned to owners
#   - validate the returnTo path in signup requests and set emailRedirectTo
# In production set this to your real domain, e.g. https://axiomaquatics.com
SITE_URL=http://localhost:3000
# Number of reverse-proxy hops between the internet and this server.
# 0 (default) disables proxy trust — correct for local dev.
# Set to 1 on Railway or any single-proxy host so the rate limiter keys on the
# real client IP instead of the proxy address.
TRUST_PROXY=0
# Secret header value for POST /internal/cron/tick — set to any random string.
# In Railway: generate with `openssl rand -hex 32` and set as env var.
CRON_SECRET=your-cron-secret
# Integration-test credentials live in a separate apps/api/.env.test (gitignored).
# See apps/api/.env.test.example and docs/decisions/035-test-database-isolation.md.
#
# Stripe (ADR 036 Phase 3). Both values live ONLY on the API — never on Vercel,
# never as NEXT_PUBLIC_*. Get the test secret key from the Stripe dashboard
# under Developers > API keys (sk_test_...). The webhook secret is printed
# by the Stripe CLI on startup:
#   stripe listen --forward-to http://localhost:3001/webhooks/stripe
# The CLI rotates the secret per session, so re-paste whenever you start a
# fresh `stripe listen`.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-local-webhook-secret
