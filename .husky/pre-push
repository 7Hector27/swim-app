#!/usr/bin/env sh

set -e

run_step() {
  step_name="$1"
  shift
  echo ""
  echo "pre-push: running $step_name"
  if ! "$@"; then
    echo ""
    echo "pre-push: FAILED at $step_name — push aborted"
    exit 1
  fi
}

run_step "pnpm typecheck" pnpm typecheck
run_step "pnpm lint" pnpm lint
run_step "pnpm test" pnpm test
run_step "pnpm --filter web build" pnpm --filter web build

echo ""
echo "pre-push: all checks passed"
